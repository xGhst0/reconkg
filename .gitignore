# Corpora and feeds are built locally from data you fetch yourself.
# They are large, they are someone else's licence to honour, and they go
# stale -- none of which belongs in git.
*.db
*.db-wal
*.db-shm
feeds/
snapshots/
_fetch_manifest.json

# The distributable archive is built FROM this repo. Committing it
# means a copy of the repo inside the repo, and a 1.1MB blob that stays
# in git history forever even after deletion.
reconkg.zip
*.zip
